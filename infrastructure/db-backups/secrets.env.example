# Template. Real values live ONLY on the VPS at /home/ubuntu/majlisna-backups/secrets.env
# (chmod 600, owner ubuntu, injected into the container via compose `env_file`).
# install.sh writes it on the first install: it generates PGPASSWORD and copies the
# SeaweedFS keys from LaTabdhir's secrets.env without printing them. NEVER commit it.
#
# Keep EVERY name below, even empty: the DAG reads each one, and Dagu leaves a missing
# name as a literal reference instead of an empty value.

# ── majlisna-db, read-only role from backup-role.sql (never the POSTGRES_USER superuser)
PGHOST=majlisna-db
PGPORT=5432
PGUSER=majlisna_backup
PGDATABASE=majlisna
PGPASSWORD=

# ── SeaweedFS on the same VPS (LaTabdhir's backup store), bucket of its own
S3_ENDPOINT=http://latabdhir-backup-seaweedfs:8333
S3_BUCKET=majlisna-db-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
# A COUNT of objects, not days: 30 daily runs ~ 30 days. Manual runs use versions too.
RETENTION_VERSIONS=30

# ── Alerts
# Private Kuma push URL, internal hostname (the container shares Majlisna's internal
# network with monitoring-uptime-kuma), e.g. http://monitoring-uptime-kuma:3001/api/push/<token>?status=up&msg=OK&ping=
# Push monitor interval 93600 s (26 h). Sent only after a fully successful run.
BACKUP_HEARTBEAT_URL=
# Optional Discord webhook for the success/failure summary. Empty = no summary.
DISCORD_WEBHOOK=

# ── Optional off-host copy (AWS S3 or any S3-compatible store). Empty bucket = disabled.
# Give the key PutObject/GetObject/ListBucket only, no DeleteObject, and let a bucket
# lifecycle rule expire old objects (OFFSITE_RETENTION_VERSIONS=0): a compromised VPS
# then cannot erase the off-host history. See docs/operations/backups.md.
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_BUCKET=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_REGION=eu-west-3
OFFSITE_S3_ADDRESSING=auto
OFFSITE_S3_PREFIX=majlisna/
OFFSITE_S3_STORAGE_CLASS=
OFFSITE_RETENTION_VERSIONS=0
